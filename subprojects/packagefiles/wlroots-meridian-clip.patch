+void wlr_scene_tree_set_meridian_clip(struct wlr_scene_tree *tree,
+		const pixman_region32_t *clip) {
+	if (!clip && !tree->meridian_clip) {
+		return;
+	}
+	if (clip && tree->meridian_clip &&
+			pixman_region32_equal(tree->meridian_clip, clip)) {
+		return;
+	}
+
+	if (clip) {
+		pixman_region32_t *copy = malloc(sizeof(*copy));
+		if (!copy) {
+			return;
+		}
+		pixman_region32_init(copy);
+		if (!pixman_region32_copy(copy, clip)) {
+			pixman_region32_fini(copy);
+			free(copy);
+			return;
+		}
+		if (tree->meridian_clip) {
+			pixman_region32_fini(tree->meridian_clip);
+			free(tree->meridian_clip);
+		}
+		tree->meridian_clip = copy;
+	} else {
+		pixman_region32_fini(tree->meridian_clip);
+		free(tree->meridian_clip);
+		tree->meridian_clip = NULL;
+	}
+
+	scene_node_update(&tree->node, NULL);
 }
 
