+/* x and y describe the leaf origin in the region's coordinate space. */
+static void scene_node_apply_clips(struct wlr_scene_node *node, int x, int y,
+		pixman_region32_t *region) {
+	for (; node->parent; node = &node->parent->node) {
+		x -= node->x;
+		y -= node->y;
+		const pixman_region32_t *clip = node->parent->meridian_clip;
+		if (clip) {
+			pixman_region32_translate(region, -x, -y);
+			pixman_region32_intersect(region, region, clip);
+			pixman_region32_translate(region, x, y);
+		}
+	}
+}
